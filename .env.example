# Copy this file to .env and fill in your values.
#
# Browser-safe Supabase settings only.
# For self-hosted Supabase, use the public Kong/API URL and anon key.
# Either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY may be used,
# but most self-hosted setups expose ANON_KEY rather than publishable keys.
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put Postgres URLs, postgres passwords, service role keys, or JWT secrets
# in this frontend .env file. Use scripts/supabase-push-db.sh for DB migrations.

# AI provider secrets are configured in Supabase Edge Function secrets, not here:
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=...
# AI_INIT_MODEL=...
# AI_WRITING_MODEL=...
